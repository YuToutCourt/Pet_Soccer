         ParentCenteringX(0)
         ParentCenteringY(0)
         ParentSizingX(0)
         ParentSizingY(0)
      }// [UIStatic] ID_MSG1

   }// [UIStatic] ID_FRAME_BRACKET
   EditTexture("er_t_red.png")
   EditBorderWidth(2.0)
   EditBorderSens(3.0)
   EditCursor("c_arrow.png")
   EditCursorSize("data/interface/c_resize.png")
   EditCursorMove("data/interface/c_move.png")
