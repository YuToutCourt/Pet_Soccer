# Copier en .env (jamais versionné) et remplir.
POSTGRES_PASSWORD=change-moi
# Port de Postgres sur 127.0.0.1 (administration par tunnel SSH)
POSTGRES_PORT=54320
# Port UDP du serveur de jeu, ouvert sur Internet
GAME_PORT=7777
# Site : adresse et port d'écoute sur le VPS, pour le reverse proxy (0.0.0.0 pour l'ouvrir directement)
WEB_BIND=127.0.0.1
WEB_PORT=8080
